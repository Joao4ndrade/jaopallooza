# Configurações para o "docker compose up". Copie este arquivo para ".env" nesta mesma pasta:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
# Tudo é opcional: sem .env, o projeto roda com os valores padrão.

# Quem vira admin ao fazer login. Crie sua conta com esse nome ANTES de divulgar o link!
ADMIN_NAMES=João

# Segredo dos logins. Para produção, gere um com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-um-segredo-grande-e-aleatorio

# "Senha da festa" para criar conta. Vazio = qualquer pessoa com o link pode se cadastrar.
INVITE_CODE=

# Endereço do site (usado no link do e-mail de recuperação de senha).
FRONTEND_URL=http://localhost:8080

# E-mail. Sem SMTP_HOST, o link de recuperação aparece em: docker compose logs api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JAOPALLOOZA <seu@gmail.com>
SMTP_SECURITY=starttls
