# Configuração de PRODUÇÃO. Na VPS, dentro da pasta do projeto:
#   cp deploy/production.env.example .env
#   nano .env
# Nunca suba o .env para o GitHub (ele já está no .gitignore).

# Endereço do site, SEM https:// e sem barra no final.
# Domínio próprio:   DOMAIN=jaopallooza.com.br
# Sem domínio (grátis): use o IP da VPS com traços + .sslip.io, ex.: DOMAIN=203-0-113-10.sslip.io
# (outras apps na mesma VPS podem usar subdomínios, ex.: agrolife.203-0-113-10.sslip.io)
DOMAIN=

# Gere cada segredo com:  openssl rand -hex 32
# (use só letras e números: a senha do banco entra numa URL)
POSTGRES_PASSWORD=
JWT_SECRET=

# Quem vira admin ao fazer login. Crie sua conta com esse nome ANTES de divulgar o link!
ADMIN_NAMES=João

# Opcional: exige esse código para criar conta. Vazio = cadastro aberto.
INVITE_CODE=

# E-mail de recuperação de senha (Gmail com "senha de app": veja o README).
# Sem SMTP_HOST, o link aparece em: docker compose -f docker-compose.prod.yml logs api
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JAOPALLOOZA <seuemail@gmail.com>
SMTP_SECURITY=starttls
