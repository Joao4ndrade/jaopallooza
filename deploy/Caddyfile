# O Caddy pega o certificado HTTPS sozinho para o domínio em DOMAIN (precisa que o
# DNS do domínio já aponte para o IP da VPS e que as portas 80 e 443 estejam abertas).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy web:80
}
