# Copie para .env (o arquivo .env não vai pro git).

# Banco Postgres. Com o docker compose do projeto, este valor já funciona.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jaopallooza

# Segredo dos tokens de login. Em produção gere um assim:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-um-segredo-grande-e-aleatorio

# Quem vira admin ao fazer login (separados por vírgula). Cadastre-se ANTES de divulgar o link!
ADMIN_NAMES=João

# Opcional: se preenchido, o cadastro exige esse código. Compartilhe o link como
#   https://seu-site/?convite=ESSE_CODIGO
# que o código é preenchido automaticamente.
INVITE_CODE=

# Origens do front liberadas no CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173

# Endereço do site (o link do e-mail de recuperação aponta pra cá).
FRONTEND_URL=http://localhost:5173

# E-mail para recuperação de senha. Sem SMTP_HOST, o link aparece no terminal da API.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=seu@gmail.com e SMTP_PASSWORD = "senha de app"
# (gere em https://myaccount.google.com/apppasswords; precisa da verificação em 2 etapas ligada).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JAOPALLOOZA <seu@gmail.com>
# starttls (porta 587), ssl (porta 465) ou none
SMTP_SECURITY=starttls
